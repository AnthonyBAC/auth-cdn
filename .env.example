NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPEN_METEO_TIMEOUT_MS=4500

# Proceso de servidor para preparar avisos (sin conexión MQ todavía)
MQ_SCHEDULER_INTERVAL_MS=30000
MQ_SCHEDULER_BATCH_SIZE=100

# Productor nativo IBM MQ. Completar con la configuración del equipo.
MQ_QUEUE_MANAGER=
MQ_QUEUE=
MQ_CHANNEL=
MQ_CONNECTION_NAME=
MQ_USERNAME=
MQ_PASSWORD=
MQ_TLS_CIPHER_SPEC=
MQ_TLS_PEER_NAME=
MQ_TLS_KEY_REPOSITORY=
MQ_TLS_KEY_REPOSITORY_PASSWORD=
MQ_TLS_CERTIFICATE_LABEL=
MQ_PRODUCER_INTERVAL_MS=5000

# Resumen de tablero Request/Reply. Reutiliza MQ_PRODUCER_* para el puente
# (PUT Request + GET Reply) y MQ_USERNAME/MQ_PASSWORD para el respondedor
# (GET Request + PUT Reply). No cambia los permisos de las colas.
MQ_SUMMARY_REQUEST_QUEUE=AUTHCDN.SUMMARY.REQUEST.Q
MQ_SUMMARY_REPLY_QUEUE=AUTHCDN.SUMMARY.REPLY.Q
MQ_SUMMARY_TIMEOUT_MS=8000
MQ_SUMMARY_REQUEST_TTL_MS=15000
MQ_SUMMARY_WAIT_MS=5000
MQ_SUMMARY_INTERVAL_MS=2000
MQ_SUMMARY_MAX_ATTEMPTS=3
MQ_SUMMARY_REPLY_TTL_MS=60000
MQ_SUMMARY_BRIDGE_HOST=127.0.0.1
MQ_SUMMARY_BRIDGE_PORT=4100
MQ_SUMMARY_BRIDGE_URL=http://127.0.0.1:4100
MQ_SUMMARY_BRIDGE_TOKEN=
MQ_SUMMARY_HTTP_TIMEOUT_MS=12000

# PoC de diagnóstico IBM MQ en Vercel Functions (solo MQCONNX + MQOPEN/INQUIRE).
# MQ_POC_SECRET: secreto de servidor para proteger el endpoint /api/mq/poc.
MQ_POC_SECRET=
MQ_POC_QUEUE=
# Keystore TLS en base64 para entornos sin sistema de archivos persistente
# (Vercel). Alternativa a MQ_TLS_KEY_REPOSITORY. Nunca commitear su contenido.
MQ_TLS_KEY_REPOSITORY_BASE64=
MQ_TLS_KEY_STH_BASE64=
MQ_TLS_KEY_RDB_BASE64=
